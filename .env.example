# Team, hunt times, vehicle groups, logo and Discord are set in Beheer → Algemeen (served by the API at /config).
API_BASE_URL=

# Feature flags
TEAMS_AREA_EDITING=false

# Sentry (sentry.io) for website errors. Optional: without SENTRY_DSN nothing is sent.
# Reports go through the server's /sentry-tunnel (set SENTRY_SITE_DSN there to the same DSN).
SENTRY_DSN=
# e.g. production; defaults to the Vite mode
SENTRY_ENVIRONMENT=
